{
  "id": "root",
  "cloned_from": {
    "name": "estro",
    "version": "local"
  },
  "type": "row",
  "gap": 0,
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "xmux-workspace-chrome"
          },
          "size": {
            "px": 36
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "block",
          "content": {
            "mod": "xmux-better-sidebar",
            "props": {
              "view": "lists"
            }
          },
          "min": 90
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "xmux-better-sidebar",
            "props": {
              "view": "footer"
            }
          },
          "size": {
            "px": 28
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "gap": 0,
      "children": [
        {
          "id": "tabs-row",
          "type": "row",
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "content": {
                "mod": "xmux-better-tabs",
                "props": {
                  "rememberPanels": {
                    "container": "panel",
                    "stack": "panel-body"
                  },
                  "buttons": [
                    {
                      "id": "files",
                      "label": "Files",
                      "icon": "file",
                      "group": "panels",
                      "action": {
                        "type": "panel",
                        "container": "panel",
                        "stack": "panel-body",
                        "target": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "label": "Changes",
                      "icon": "changes",
                      "group": "panels",
                      "action": {
                        "type": "panel",
                        "container": "panel",
                        "stack": "panel-body",
                        "target": "changes"
                      }
                    },
                    {
                      "id": "prs",
                      "label": "PRs",
                      "icon": "mods/xmux-branch-pr/icons/pull-request.svg",
                      "group": "panels",
                      "action": {
                        "type": "panel",
                        "container": "panel",
                        "stack": "panel-body",
                        "target": "pull-requests"
                      }
                    },
                    {
                      "id": "issues",
                      "label": "Issues",
                      "icon": "mods/xmux-branch-issue/icons/issue.svg",
                      "group": "panels",
                      "action": {
                        "type": "panel",
                        "container": "panel",
                        "stack": "panel-body",
                        "target": "linear-issues"
                      }
                    }
                  ],
                  "defaultHidden": [
                    "issues"
                  ]
                }
              },
              "size": {
                "weight": 1
              },
              "window_drag": true
            }
          ],
          "size": {
            "px": 36
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "gap": 1,
          "background": "raised",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "radius": 0,
                  "gap": 1,
                  "lone": true,
                  "focus": {
                    "width": 1,
                    "color": "border"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "xmux-better-files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "xmux-better-changes"
                      }
                    },
                    {
                      "id": "pull-requests",
                      "type": "block",
                      "content": {
                        "mod": "xmux-branch-pr"
                      }
                    },
                    {
                      "id": "linear-issues",
                      "type": "block",
                      "content": {
                        "mod": "xmux-branch-issue"
                      }
                    }
                  ],
                  "active": "changes"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900
            }
          ],
          "padding": [
            1,
            1
          ]
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "xmux-status"
          },
          "size": {
            "px": 28
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "theme": "ghostty-solarized-dark",
  "terminal_padding": [
    2,
    2
  ],
  "terminal_opacity": 0.9700000286102295,
  "titlebar": "none",
  "traffic_lights": [
    12,
    11
  ]
}
